# Application
APP_NAME="Arizona Lavka Marketplace"
DEBUG=false

# Database
POSTGRES_USER=arizonalavka
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=arizonalavka
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT Secrets (generate secure random strings!)
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET_KEY=your_refresh_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# External API
MARKETPLACE_API_URL=https://api.arz.market
MARKETPLACE_CACHE_TTL=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://your-domain.com
